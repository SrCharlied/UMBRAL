# Texto con LF en todas las plataformas (core.autocrlf no aplica a estos archivos).
* text=auto eol=lf

# Modelos: se versionan byte a byte; ningun cambio de fin de linea.
*.obj -text
*.mtl -text

# Imagenes y fuentes editables binarias.
*.png binary
*.jpg binary
*.blend binary

# Criatura y paquetes del tentaculo: byte a byte (los paquetes se verifican por hash).
assets/creature/** -text
